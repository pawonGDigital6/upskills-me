{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "acf-block/impact-highlights",
	"version": "1.0.0",
	"title": "Impact Highlights",
	"category": "acf-blocks",
	"icon": "chart-line",
	"description": "Dark section with a stacked header over translucent highlight cards.",
	"keywords": [ "impact", "results", "highlights" ],
	"supports": {
