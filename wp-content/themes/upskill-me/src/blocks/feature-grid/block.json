{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "acf-block/feature-grid",
	"version": "1.0.0",
	"title": "Feature Grid",
	"category": "acf-blocks",
	"icon": "screenoptions",
	"description": "Split section header over three or four columns of icon cards that turn dark on hover.",
	"keywords": [ "features", "cards", "grid" ],
	"supports": {
		"html": false,
		"anchor": true,
		"multiple": true
	},
	"textdomain": "upskill-me",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php",
		"blockVersion": 3,
		"hideFieldsInSidebar": true,
		"expandedEditorButtons": [
			"toolbar"
		]
	}
}
