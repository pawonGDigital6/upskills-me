{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "acf-block/location-map",
	"version": "1.0.0",
	"title": "Location Map",
	"category": "acf-blocks",
	"icon": "location-alt",
	"description": "A centred header over an embedded Google map.",
	"keywords": [
		"map",
		"location",
		"contact"
	],
	"supports": {
		"html": false,
		"anchor": true,
		"multiple": false
	},
	"textdomain": "upskill-me",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php",
		"blockVersion": 3,
		"hideFieldsInSidebar": true,
		"expandedEditorButtons": [
			"toolbar"
		]
	}
}
