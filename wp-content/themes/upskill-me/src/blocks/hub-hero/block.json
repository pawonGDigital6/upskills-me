{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "acf-block/hub-hero",
	"version": "1.0.0",
	"title": "Hub Hero",
	"category": "acf-blocks",
	"icon": "cover-image",
	"description": "Hub page hero (Industries, Categories): centred heading with two floating tags and three photo cards.",
	"keywords": [
		"hero",
		"industries",
		"categories",
		"hub"
	],
	"supports": {
		"html": false,
		"anchor": true,
		"multiple": false
	},
	"textdomain": "upskill-me",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php",
		"blockVersion": 3,
		"hideFieldsInSidebar": true,
		"expandedEditorButtons": [
			"toolbar"
		]
	}
}
