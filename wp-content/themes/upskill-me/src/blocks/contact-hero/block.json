{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "acf-block/contact-hero",
	"version": "1.0.0",
	"title": "Contact Hero",
	"category": "acf-blocks",
	"icon": "email-alt",
	"description": "Headline and buttons over a photo, beside an enquiry form (Contact Form 7).",
	"keywords": [
		"contact",
		"form",
		"hero"
	],
	"supports": {
		"html": false,
		"anchor": true,
		"multiple": false
	},
	"textdomain": "upskill-me",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php",
		"blockVersion": 3,
		"hideFieldsInSidebar": true,
		"expandedEditorButtons": [
			"toolbar"
		]
	}
}
