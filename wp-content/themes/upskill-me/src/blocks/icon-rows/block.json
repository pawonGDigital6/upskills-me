{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "acf-block/icon-rows",
	"version": "1.0.0",
	"title": "Icon Rows",
	"category": "acf-blocks",
	"icon": "list-view",
	"description": "Dark section with a stacked header over ruled rows of icon, title and text.",
	"keywords": [
		"rows",
		"list",
		"solution"
	],
	"supports": {
		"html": false,
		"anchor": true,
		"multiple": true
	},
	"textdomain": "upskill-me",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php",
		"blockVersion": 3,
		"hideFieldsInSidebar": true,
		"expandedEditorButtons": [
			"toolbar"
		]
	}
}
