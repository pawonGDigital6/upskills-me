{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "acf-block/textured-cards",
	"version": "1.0.0",
	"title": "Textured Cards",
	"category": "acf-blocks",
	"icon": "grid-view",
	"description": "Centred section header over three tall textured cards, each in a dark, light or purple tone.",
	"keywords": [
		"cards",
		"textured",
		"highlights"
	],
	"supports": {
		"html": false,
		"anchor": true,
		"multiple": true
	},
	"textdomain": "upskill-me",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php",
		"blockVersion": 3,
		"hideFieldsInSidebar": true,
		"expandedEditorButtons": [
			"toolbar"
		]
	}
}
