{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf-block/video-feature",
  "version": "1.0.0",
  "title": "Video Feature",
  "category": "acf-blocks",
  "icon": "format-video",
  "description": "Dark section: copy and feature cards beside a video card with supporting facts.",
  "keywords": [
    "video",
    "features"
  ],
  "supports": {
    "html": false,
    "anchor": true,
    "multiple": true
  },
  "textdomain": "upskill-me",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "acf": {
    "mode": "preview",
    "renderTemplate": "render.php",
    "blockVersion": 3,
    "hideFieldsInSidebar": true,
    "expandedEditorButtons": [
      "toolbar"
    ]
  }
}