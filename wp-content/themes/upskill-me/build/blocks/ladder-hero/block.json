{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf-block/ladder-hero",
  "version": "1.0.0",
  "title": "Ladder Hero",
  "category": "acf-blocks",
  "icon": "cover-image",
  "description": "Why UpSkill Me hero: centred headline and button, a badge either side and the ladder of steps.",
  "keywords": [
    "hero",
    "ladder",
    "why",
    "intro"
  ],
  "supports": {
    "html": false,
    "anchor": true,
    "multiple": false
  },
  "textdomain": "upskill-me",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "acf": {
    "mode": "preview",
    "renderTemplate": "render.php",
    "blockVersion": 3,
    "hideFieldsInSidebar": true,
    "expandedEditorButtons": [
      "toolbar"
    ]
  }
}