{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf-block/faqs",
  "version": "1.0.0",
  "title": "FAQs",
  "category": "acf-blocks",
  "icon": "editor-help",
  "description": "Accordion of FAQs, by topic or hand-picked, beside a help card.",
  "keywords": [
    "faq",
    "questions",
    "accordion"
  ],
  "supports": {
    "html": false,
    "anchor": true,
    "multiple": true
  },
  "textdomain": "upskill-me",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "acf": {
    "mode": "preview",
    "renderTemplate": "render.php",
    "blockVersion": 3,
    "hideFieldsInSidebar": true,
    "expandedEditorButtons": [
      "toolbar"
    ]
  }
}