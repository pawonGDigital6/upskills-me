{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf-block/heading-hero",
  "version": "1.0.0",
  "title": "Heading Hero",
  "category": "acf-blocks",
  "icon": "cover-image",
  "description": "Inner page hero with just an eyebrow, headline and intro: centred (Case Studies) or left on a panel (FAQs).",
  "keywords": [
    "hero",
    "heading",
    "faqs",
    "intro"
  ],
  "supports": {
    "html": false,
    "anchor": true,
    "multiple": false
  },
  "textdomain": "upskill-me",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "acf": {
    "mode": "preview",
    "renderTemplate": "render.php",
    "blockVersion": 3,
    "hideFieldsInSidebar": true,
    "expandedEditorButtons": [
      "toolbar"
    ]
  }
}